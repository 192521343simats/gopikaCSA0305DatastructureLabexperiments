#include <stdio.h>

#define INF 999

int main()
{
    int n, cost[10][10], selected[10] = {0};
    int i, j, x, y, min, total = 0;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter cost matrix:\n");
    for(i = 0; i < n; i++)
        for(j = 0; j < n; j++)
            scanf("%d", &cost[i][j]);

    selected[0] = 1;

    printf("Edges in MST:\n");

    for(i = 0; i < n - 1; i++)
    {
        min = INF;

        for(j = 0; j < n; j++)
            if(selected[j])
                for(x = 0; x < n; x++)
                    if(!selected[x] && cost[j][x] < min)
                    {
                        min = cost[j][x];
                        y = j;
                        x = x;
                    }

        selected[x] = 1;
        printf("%d - %d = %d\n", y, x, min);
        total += min;
    }

    printf("Minimum Cost = %d\n", total);

    return 0;
}
