#include <stdio.h>

#define INF 999

int main()
{
    int n, cost[10][10], dist[10], vis[10] = {0};
    int i, j, u, min, src;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter cost matrix:\n");
    for(i = 0; i < n; i++)
        for(j = 0; j < n; j++)
            scanf("%d", &cost[i][j]);

    printf("Enter source vertex: ");
    scanf("%d", &src);

    for(i = 0; i < n; i++)
        dist[i] = cost[src][i];

    dist[src] = 0;
    vis[src] = 1;

    for(i = 1; i < n; i++)
    {
        min = INF;
        u = -1;

        for(j = 0; j < n; j++)
            if(!vis[j] && dist[j] < min)
            {
                min = dist[j];
                u = j;
            }

        if(u == -1) break;

        vis[u] = 1;

        for(j = 0; j < n; j++)
            if(!vis[j] && dist[u] + cost[u][j] < dist[j])
                dist[j] = dist[u] + cost[u][j];
    }

    printf("Shortest distances:\n");
    for(i = 0; i < n; i++)
        printf("%d -> %d = %d\n", src, i, dist[i]);

    return 0;
}
